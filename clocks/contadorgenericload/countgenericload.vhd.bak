library library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;

entity countgenericload is
    generic(
        N: integer := 4
    );
    port(
        clk: in std_logic;
        reset_a: in std_logic;
        load: in std_logic;
        data: in std_logic_vector(N-1 downto 0);
        counter: out std_logic_vector(N-1 downto 0)
    );
end countgenericload;

architecture behav of countgenericload is
    signal count: std_logic_vector(N-1 downto 0) := (others=>"0");
    begin 

    Process(clk, reset_a)
    begin 
        if reset_a ='1' then
            count <= (others=>"0");
        elsif load = '1' then
            count <= data;
        elsif rising_edge(clk) then
            count <= count + 1;
        end if;
    end process;
end
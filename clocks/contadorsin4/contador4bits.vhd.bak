library ieee;
use ieee.std_logic_1164.all;

entity contador4bits is
    port(
        clk: in std_logic;
        counter: out std_logic_vector(3 downto 0)
    );
end contador4bits;

architecture behav of contador4bits is
    signal count: std_logic_vector(3 downto 0) := "0000";
    begin 

    Process(clk)
    begin 
        if rising_edge(clk) then
            count <= count + 1;
        end if;
    end process;
end
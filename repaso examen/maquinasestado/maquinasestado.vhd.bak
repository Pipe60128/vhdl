library library ieee;
use ieee.std_logic_1164.all;

entity maquinasestado is
    port(
        clk, reset, bot : in std_logic;
        leds : out std_logic_vector(1 downto 0)
    );
end maquinasestado;

architecture behav if maquinasestado is
    type state_type is (S0, S1, S2);
    signal state : state_type;
    signal next_state : state_type;

    begin
        process(clk, reset)
        begin
            if reset = '0' then
                state <= S0;
            elsif rising_edge(clk) then
                if bot = '1' then
                    state <= S0;
                    else
                    state <= next_state;
                end if;
            end if;
        end process;

        process(state)
        begin 
            case state is 
                when S0 =>
                    next_state <= S1;
                    leds <= "01";
                when S1 =>
                    next_state <= S2;
                    leds <= "10";
                when S2 =>
                    next_state <= S0;
                    leds <= "11";
                when others =>
                    next_state <= S0;
                    leds <= "00";
                end case;
            end process;
        
end behav;
LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY full_adder_rest IS
    PORT (
        A, B : IN STD_LOGIC_VECTOR (3 DOWNTO 0);
        Cin : IN STD_LOGIC;
        S : OUT STD_LOGIC_VECTOR (3 DOWNTO 0);
        Cout : OUT STD_LOGIC
    );
END full_adder_rest;

ARCHITECTURE behav OF full_adder_rest IS

    COMPONENT fulladder IS
        PORT (
            A, B, Cin : IN STD_LOGIC;
            S, Cout : OUT STD_LOGIC);
    END COMPONENT;

    SIGNAL C : STD_LOGIC_VECTOR (3 DOWNTO 1);
    Signal XORB : STD_LOGIC_VECTOR (3 DOWNTO 0);
	 

BEGIN
    XORB(0) <= B(0) xor Cin;
    XORB(1) <= B(1) xor Cin;
    XORB(2) <= B(2) xor Cin;
    XORB(3) <= B(3) xor Cin;

    u0 : fulladder PORT MAP(A(0), XORB(0), Cin, S(0), C(1));
    u1 : fulladder PORT MAP(A(1), XORB(1), C(1), S(1), C(2));
    u2 : fulladder PORT MAP(A(2), XORB(2), C(2), S(2), C(3));
    u3 : fulladder PORT MAP(A(3), B(3), C(3), S(3), Cout);
END behav;